# Server Environment Configuration
PORT=5000
NODE_ENV=development

# AI Provider Configuration: 'gemini' | 'groq' | 'mock'
AI_PROVIDER=mock

# Google Gemini API Key (Eligible Free-Tier Model e.g., gemini-1.5-flash or gemini-2.0-flash)
# Get a key at https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model Name
GEMINI_MODEL=gemini-1.5-flash

# Optional Fallback: Groq API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# Supabase PostgreSQL Configuration
# If unset, server will seamlessly use in-memory/JSON fallback storage for instant local development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Security
JWT_SECRET=psysim-super-secret-development-jwt-key
CORS_ORIGIN=http://localhost:5173
