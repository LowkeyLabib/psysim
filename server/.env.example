# Copy to server/.env. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CORS_ORIGIN=http://127.0.0.1:5173
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative provider; select explicitly, never used as a silent fallback.
GROQ_API_KEY=
GROQ_MODEL=
# Production authentication. No service-role key is required by this server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Local, single-user access only. Set false in any hosted environment.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=
ALLOW_UNREVIEWED_CASES=true
# Relative paths resolve from the server working directory. Use a persistent
# absolute path and exactly one server process for a hosted installation.
DATABASE_FILE=./data/psysim.sqlite
