# Copy to server/.env. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CORS_ORIGIN=http://127.0.0.1:5173
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional alternative provider; select explicitly, never used as a silent fallback.
GROQ_API_KEY=
GROQ_MODEL=
# Neon account infrastructure. Get values from your existing Neon branch.
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Optional overrides. Managed Neon Auth defaults both to the Auth URL origin,
# without /neondb/auth. Confirm with the branch configuration before overriding.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=
# Local, single-user access only. Set false in any hosted environment.
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=
ALLOW_UNREVIEWED_CASES=true
# Relative paths resolve from the server working directory. Use a persistent
# absolute path and exactly one server process for a hosted installation.
DATABASE_FILE=./data/psysim.sqlite
